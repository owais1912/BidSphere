#!/bin/sh
# Maven Wrapper Script for Unix
# Generated for BidSphere project

MAVEN_VERSION=3.9.6
MAVEN_HOME_DIR="$HOME/.m2/wrapper/dists/apache-maven-$MAVEN_VERSION-bin"
MAVEN_JAR="$MAVEN_HOME_DIR/apache-maven-$MAVEN_VERSION/bin/mvn"

if [ ! -f "$MAVEN_JAR" ]; then
    echo "Downloading Maven $MAVEN_VERSION..."
    mkdir -p "$MAVEN_HOME_DIR"
    curl -fsSL "https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz" \
        | tar -xz -C "$MAVEN_HOME_DIR"
fi

exec "$MAVEN_HOME_DIR/apache-maven-$MAVEN_VERSION/bin/mvn" "$@"
